<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="hamals_robot">
    <pose>0 0 0.25 0 0 0</pose>

    <link name="base_link">
      <inertial>
        <mass>10.0</mass>
      </inertial>

      <collision name="base_collision">
        <geometry>
          <box>
            <size>0.7 0.45 0.35</size>
          </box>
        </geometry>
      </collision>

      <visual name="base_visual">
        <geometry>
          <box>
            <size>0.7 0.45 0.35</size>
          </box>
        </geometry>
        <material>
          <ambient>0.75 0.75 0.75 1</ambient>
          <diffuse>0.75 0.75 0.75 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>